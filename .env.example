# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# MongoDB Atlas (free M0 cluster): paste the connection string from Atlas > Connect > Drivers,
# put your DB user's password in, and make sure a database name is in the path (before the "?").
# Full walkthrough: docs/atlas-setup.md
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>.mongodb.net/quickcart-compare?retryWrites=true&w=majority
# Local MongoDB alternative: mongodb://127.0.0.1:27017/quickcart-compare
CLIENT_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
# Optional: only needed if a geocoding / authorised provider integration is added later
GEOCODING_API_KEY=
PROVIDER_API_KEY=

# Optional tuning
# TRUST_PROXY=1               # set to 1 when deployed behind one reverse proxy (Render, Railway...)
# ADAPTER_TIMEOUT_MS=3000     # per-provider time limit for /compare
# QUOTE_STALE_AFTER_MINUTES=  # mark quotes STALE after this age even if not yet expired
